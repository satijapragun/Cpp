#include <iostream>
#include <string>
using namespace std;
class Product
{
private:
    int product_id;
    string product;
    float price;
    int sales[12];

public:
    void input(){
        cout << "Enter Product ID: ";
        cin >> product_id;
        cin.ignore();
        cout << "Enter Product Name: ";
        getline(cin, product);
        cout << "Enter Price: ";
        cin >> price;
        cout << "Enter sales for each month:" << endl;
        for (int i = 0; i < 12; i++)
        {
            cout << "Month "<<i+1 << ": ";
            cin >> sales[i];      }    }
    void output()
    {
        int quantity = 0;
        for (int i = 0; i < 12; i++)
        {
            quantity+= sales[i];   }
        float bill =quantity * price;
        cout<<"\nProduct ID: "<<product_id<< endl;
        cout<<"Product Name: "<<product<<endl;
        cout<<"Price: "<<price<<endl;
        cout<<"Total Quantity Sold: "<<quantity<<endl;
        cout<<"Total Bill:"<<bill<<endl;
    }
};

int main()
{
    int x;
    cout << "Enter number of products: "<<endl;
    cin >>x;
    Product p[10]; 
    for (int i = 0;i<x;i++)
    {
        cout <<"Enter data for product: "<< i+1<<endl;
        p[i].input();
    }
    for (int i=0;i<x;i++)
    {
        cout <<Product: "<<i+1<<endl;
        p[i].output();
    }
    return 0;}
