#include <iostream>
#include <string>
using namespace std;
class Employee
{
private:
    int id;
    string nm;
    float sal;
    float bon;
public:
    Employee()
    {
        id = 0;
        nm = "Abeer";
        sal = 0;
        bon = 0;
    }
    Employee(int i, string n, float s, float b)
    {
        id = i;
        nm = n;
        sal = s;
        bon = b;
    }
    float total()
    {
        return sal + bon;
    }
    void output()
    {
        cout<<"\nEmployee ID: "<< id << endl;
        cout<<"Name: " << nm <<endl;
        cout<<"Salary: " <<sal<<endl;
        cout<<"Bonus: " <<bon <<endl;
        cout<<"Total Salary: "<<total()<<endl;
    }};
int main(){
    Employee e1;
    cout <<"Employee (Default Constructor):";
    e1.output();
    Employee e2(101, "Akira", 60000, 4200);
    cout<<"\nEmployee (Parameterized Constructor):";
    e2.output();
    return 0;}

