#include <iostream>
#include <string>
using namespace std;
class Student
{
private:
    int roll;
    string name;
    float marks[5];
    float percent;
    float total;

public:
    void input()
    {
        cout << "Enter Roll Number: ";
        cin >> roll;

        cin.ignore();
        cout << "Enter Name: ";
        getline(cin, name);

        cout << "Enter marks for 5 subjects:" << endl;

        for (int i = 0; i < 5; i++)
        {
            cout << "Subject " << i + 1 << ": ";
            cin >> marks[i];   }
    }
    void Result()
    {
        total = 0;

        for (int i = 0; i < 5; i++)
        {
            total = total + marks[i];
        }

        percentage = total / 5;
    }
    void display() {
        cout<< "\n Student Information: " <<endl;
        cout<< "Roll number: "<<roll<< endl;
        cout<<"Name: "<<name<<endl;
        cout << "Total Marks: "<< endl;
        cout << "Percentage %: "<< endl;

        if (percent>= 40)
            cout << "Result: Passed" <<endl;
        else
            cout << "Result: Failed" <<endl;
    }
};
int main(){
    Student s;
    s.input();
    s.Result();
    s.display();
    return 0;}

